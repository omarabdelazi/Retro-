# Supabase Postgres connection string (transaction pooler for the app,
# direct connection for migrations and seeding). Server-side only.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Public Supabase client configuration. Safe for the browser; RLS is the boundary.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Absolute site URL, used for payment return redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paymob (Egypt: cards, mobile wallets, instalments). Server-side only.
# Integration ids come from the Paymob dashboard, one per payment method;
# comma-separate multiple instalment providers.
PAYMOB_SECRET_KEY=sk_test_xxx
PAYMOB_PUBLIC_KEY=pk_test_xxx
PAYMOB_HMAC_SECRET=your-hmac-secret
PAYMOB_INTEGRATION_ID_CARD=111111
PAYMOB_INTEGRATION_ID_WALLET=222222
PAYMOB_INTEGRATION_ID_INSTALLMENTS=333333
# Optional: override the webhook Paymob calls (otherwise set in the dashboard)
# PAYMOB_NOTIFICATION_URL=https://your-site/api/payments/paymob

# Protects the payment timeout sweep route (/api/payments/sweep).
CRON_SECRET=change-me
# PAYMENT_TIMEOUT_MINUTES=120
